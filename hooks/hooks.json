{
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "${CLAUDE_PLUGIN_ROOT}/bin/session-start.exe",
            "timeout": 10000
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "${CLAUDE_PLUGIN_ROOT}/bin/session-stop.exe",
            "timeout": 5000
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "mem_save",
        "hooks": [
          {
            "type": "command",
            "command": "echo {\"systemMessage\":\"BOARD CHECK: does a Cyber Mango card need creating, updating or moving for what you just saved?\"}",
            "timeout": 3000
          }
        ]
      }
    ]
  }
}
